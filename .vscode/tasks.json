{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:desktop",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/apps/rink-local/src/Icebreaker.Timekeeper.Desktop/Icebreaker.Timekeeper.Desktop.csproj",
        "-c",
        "Debug"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test:node",
      "type": "process",
      "command": "npm",
      "args": ["test"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test:dotnet",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/apps/rink-local/tests/Icebreaker.Core.Tests/Icebreaker.Core.Tests.csproj",
        "-c",
        "Debug"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "check:all",
      "type": "process",
      "command": "python",
      "args": ["tools/icebreaker.py", "check"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
