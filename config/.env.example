# For LOCALHOST DEVELOPMENT ONLY — never expose rink-local server publicly
ICEBREAKER_OPERATOR_KEY=change-this-local-development-key
ICEBREAKER_DB=./apps/rink-local/data/demo.db
HOST=127.0.0.1
PORT=8090

# Parent web accounts: optional Google OpenID Connect
# Create a Google Cloud OAuth "Web application" client.
# Authorized redirect URI: http://127.0.0.1:8090/api/parent/google/callback
# For production, use an HTTPS domain and update URI + public URL accordingly.
ICEBREAKER_PUBLIC_URL=http://127.0.0.1:8090
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email verification is currently QUEUED in parent_mail_outbox (SQLite).
# A transactional-email delivery worker/provider is REQUIRED before real user rollout.
